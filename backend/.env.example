# Copy to `.env` and adjust. The backend loads `backend/.env` via `app.config`.
#
# Schema: from this directory (`backend/`) run:
#   uv run alembic -c alembic.ini upgrade head
# Migrations live under `app/db/migrations/`. (Postgres up: `docker compose up -d postgres` here.)

# Postgres (default matches `docker compose` in this folder)
DATABASE_URL=postgresql://lumen:lumen@127.0.0.1:5432/lumen

# Clerk — same values as the Clerk dashboard / frontend. Required for POST /api/users/sync.
# JWKS (verify session JWTs from the browser)
CLERK_JWKS_URL=https://YOUR_INSTANCE.clerk.accounts.dev/.well-known/jwks.json
# Issuer in the JWT (Dashboard → API keys, Frontend API / Issuer URL)
CLERK_ISSUER=https://YOUR_INSTANCE.clerk.accounts.dev
# Only if you configure a custom JWT template / audience; otherwise leave empty
# CLERK_JWT_AUDIENCE=
