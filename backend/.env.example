# Copy to `.env` and adjust. The backend loads `backend/.env` via `app.config`.
#
# Local dev: `docker compose up -d postgres` in this directory, then:
#   uv run alembic -c alembic.ini upgrade head
#   uv run uvicorn app.main:app --reload
#
# Production VPS: see docker-compose.prod.yml and deploy.sh.
# Only the api container runs here — Postgres, Prometheus, Grafana, Loki are
# assumed to be running elsewhere on the VPS.  Point the URLs below at them.
# Set GHCR_OWNER to your GitHub username so the compose file resolves the image:
# GHCR_OWNER=yourgithubusername

# **Required** — point at your VPS Postgres instance (create the DB first).
# The VPS Postgres must have the pgvector extension: CREATE EXTENSION IF NOT EXISTS vector;
DATABASE_URL=postgresql://lumen:lumen@127.0.0.1:5432/lumen

# Google Auth — get these from Google Cloud Console Credentials page.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# JWT Secret — used to sign local session tokens. Keep secure in production.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=lumen_dev_secret_key_change_me_in_production

# —— Storage backend: local (default) | s3 | azure ——
# STORAGE_BACKEND=local
# Max upload size (bytes). Default 5242880 (5 MiB).
# MAX_PDF_UPLOAD_BYTES=5242880

# —— S3 (PDFs and extracted figure PNGs) ——
# STORAGE_BACKEND=s3
# S3_BUCKET=your-bucket-name
# AWS_REGION=us-east-1
# Optional key prefix; default `documents` → `documents/{id}/source.pdf`
# S3_KEY_PREFIX=documents
# For local dev with named profile:
# AWS_PROFILE=ai-engineer

# —— Azure Blob Storage ——
# STORAGE_BACKEND=azure
# AZURE_STORAGE_CONTAINER_NAME=chatpdfs
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net

# —— Monitoring (optional — point at your existing VPS services) ——
# LOKI_URL=http://localhost:3100
# LOKI_ENABLED=false
# PROMETHEUS_ENABLED=false

# —— OpenTelemetry tracing (optional — point at your OTLP collector) ——
# OTEL_ENABLED=true
# OTEL_SERVICE_NAME=chat-pdf-backend
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

CORS_ALLOW_ORIGINS=http://localhost:4200